rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.role in ['patient', 'therapist'];
      allow read, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }
    match /publicUsers/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }
    function relationDoc(relationId) {
      return /databases/$(database)/documents/therapistPatientRelations/$(relationId);
    }
    // The signed-in user is the therapist of an ACCEPTED relation with data.patientId
    // (data carries therapistId + relationId).
    function linked(data) {
      return data.therapistId == request.auth.uid
        && exists(relationDoc(data.relationId))
        && get(relationDoc(data.relationId)).data.patientId == data.patientId
        && get(relationDoc(data.relationId)).data.therapistId == request.auth.uid
        && get(relationDoc(data.relationId)).data.status == 'accepted';
    }

    // ── Therapist ↔ patient relations ─────────────────────────────────────
    // A relation can only be STARTED by the patient (invite code) — or by the
    // therapist of an existing relation it just transferred (sourceRelationId).
    // Either party may end it; only the patient may (re)activate it; the two
    // parties never change. A third account can neither read nor write it.
    function isTransfer(data) {
      return ('sourceRelationId' in data) && data.sourceRelationId is string
        && get(relationDoc(data.sourceRelationId)).data.therapistId == request.auth.uid
        && get(relationDoc(data.sourceRelationId)).data.patientId == data.patientId
        && get(relationDoc(data.sourceRelationId)).data.transferredToTherapistId == data.therapistId;
    }
    match /therapistPatientRelations/{id} {
      allow read: if request.auth != null
        && (resource.data.patientId == request.auth.uid || resource.data.therapistId == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.patientId is string && request.resource.data.therapistId is string
        && request.resource.data.patientId != request.resource.data.therapistId
        && ((request.resource.data.patientId == request.auth.uid) || isTransfer(request.resource.data));
      allow update: if request.auth != null
        && (resource.data.patientId == request.auth.uid || resource.data.therapistId == request.auth.uid)
        && request.resource.data.patientId == resource.data.patientId
        && request.resource.data.therapistId == resource.data.therapistId
        && (request.resource.data.status != 'accepted' || resource.data.status == 'accepted' || resource.data.patientId == request.auth.uid);
      allow delete: if false;
    }

    // ── First recommendation stage 2 (docs/F01_INITIAL_REVIEW_PLAN.md) ──
    // A cycle may never run a first recommendation that needs professional review unless it is the
    // plan's own first week: id = 'trackingCycle_initial_' + recommendationId (one per plan on every
    // device), linked to an accepted, therapist-confirmed recommendation of this patient. Its links and
    // creation time never change afterwards, so a second device cannot overwrite it. Any other cycle needs
    // its recommendation to be in the cloud already (cycleRecOk): the app syncs the recommendation first.
    function recPath(recId) { return /databases/$(database)/documents/recommendationResults/$(recId); }
    function initialPlanCycleMatches(id, data) {
      return data.get('recommendationId', null) is string
        && id == 'trackingCycle_initial_' + data.recommendationId
        && data.initialPlanAcceptance.recommendationId == data.recommendationId
        && get(recPath(data.recommendationId)).data.patientId == request.auth.uid
        && get(recPath(data.recommendationId)).data.status == 'accepted'
        && get(recPath(data.recommendationId)).data.initialConfirmation.therapistReviewId == data.recommendationId
        && data.initialPlanAcceptance.reviewVersionId == get(recPath(data.recommendationId)).data.initialConfirmation.reviewVersionId
        && data.initialPlanAcceptance.acceptedItemsKey == get(recPath(data.recommendationId)).data.initialConfirmation.acceptedItemsKey;
    }
    // Integrity pass (docs/F01_INITIAL_REVIEW_PLAN.md 8-7): the recommendation an ORDINARY cycle runs must
    // exist in the cloud, belong to the patient, be an F01 goal plan and — if it is a first recommendation —
    // carry a marker that says no review is needed and that rules can re-check (firstRecIntegrityOk).
    function cycleRecOk(data) {
      return data.get('recommendationId', null) is string
        && exists(recPath(data.recommendationId))
        && get(recPath(data.recommendationId)).data.patientId == request.auth.uid
        && get(recPath(data.recommendationId)).data.get('kind', '') == 'f01_goal'
        && (get(recPath(data.recommendationId)).data.get('origin', null) != null
          || (get(recPath(data.recommendationId)).data.get('exerciseIds', null) is list
            && get(recPath(data.recommendationId)).data.exerciseIds.size() > 0
            && get(recPath(data.recommendationId)).data.get('initialReview', {}).get('required', true) == false));
    }
    function initialPlanCycleCreateOk(id, data) {
      return data.get('initialPlanAcceptance', null) == null
        ? cycleRecOk(data)
        : initialPlanCycleMatches(id, data);
    }
    function keepsInitialPlanLink() {
      return resource.data.get('initialPlanAcceptance', null) == null
        ? (request.resource.data.get('initialPlanAcceptance', null) == null
          && (request.resource.data.get('recommendationId', null) == resource.data.get('recommendationId', null) || cycleRecOk(request.resource.data)))
        : (request.resource.data.get('initialPlanAcceptance', null) == resource.data.initialPlanAcceptance
          && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
          && request.resource.data.get('baselineAssessmentId', null) == resource.data.get('baselineAssessmentId', null)
          && request.resource.data.get('recommendationId', null) == resource.data.get('recommendationId', null)
          && request.resource.data.get('cycleStartDateKey', null) == resource.data.get('cycleStartDateKey', null));
    }
    match /trackingCycles/{id} {
      allow read: if request.auth != null && (resource.data.patientId == request.auth.uid || linked(resource.data));
      allow create: if request.auth != null && request.resource.data.patientId == request.auth.uid && request.resource.data.userId == request.auth.uid
        && initialPlanCycleCreateOk(id, request.resource.data);
      allow update: if request.auth != null && resource.data.patientId == request.auth.uid && request.resource.data.patientId == resource.data.patientId && request.resource.data.userId == resource.data.userId
        && keepsInitialPlanLink();
      allow delete: if false;
    }
    match /llmWeeklySummaries/{id} {
      allow read: if request.auth != null && (resource.data.patientId == request.auth.uid || linked(resource.data));
      allow create: if request.auth != null && linked(request.resource.data);
      allow update: if request.auth != null && linked(resource.data) && linked(request.resource.data) && request.resource.data.patientId == resource.data.patientId;
      allow delete: if false;
    }

    // ── Recommendations (first plan, D5 next-stage proposals) ─────────────
    // Written ONLY by the patient they belong to. A proposal accepted as a
    // therapist-reviewed plan must carry exactly that review's items and match
    // its basis (the patient's reported inputs / the rule) — a review of an
    // older version, or of another patient, authorizes nothing. An accepted
    // plan's items never change afterwards.
    function claimsReview(next) {
      return ('d5' in next) && next.d5 is map
        && ('confirmation' in next.d5) && next.d5.confirmation is map
        && ('therapistReviewId' in next.d5.confirmation) && next.d5.confirmation.therapistReviewId is string;
    }
    function reviewMatches(docId, next) {
      let review = get(/databases/$(database)/documents/d5TherapistReviews/$(docId)).data;
      let relation = get(relationDoc(review.relationId)).data;
      return next.d5.confirmation.therapistReviewId == docId
        && review.proposalId == docId
        && review.patientId == request.auth.uid
        && review.items == next.items
        && review.basis.reassessmentId == next.d5.reassessmentId
        && review.basis.currentLimitations == next.d5.currentLimitations
        && review.basis.hasNewOrWorseningDiscomfort == next.d5.hasNewOrWorseningDiscomfort
        && review.basis.decisionRuleId == next.d5.decisionRuleId
        && relation.therapistId == review.therapistId
        && relation.patientId == request.auth.uid
        && relation.status == 'accepted';
    }
    // The same accepted, review-backed confirmation carried over unchanged (e.g. linking the next cycle).
    function keepsAcceptedReview(docId) {
      return resource != null && resource.data.status == 'accepted' && claimsReview(resource.data)
        && request.resource.data.items == resource.data.items
        && request.resource.data.d5.confirmation == resource.data.d5.confirmation;
    }
    // Manual adoption must preserve the no-auto judgement and require a new baseline.
    function isNoAutoPlan(data) {
      return data.get('d5', null) is map
        && (data.d5.get('decision', '') == 'no_auto_decision'
          || data.d5.get('selectionRuleId', '') == 'NC-N01');
    }
    function manualNoAutoAcceptanceOk(data) {
      return data.get('status', '') != 'accepted' || !isNoAutoPlan(data)
        || (claimsReview(data)
          && data.d5.confirmation.get('handoff', {}).get('baselineReuseAllowed', true) == false
          && data.d5.confirmation.get('handoff', {}).get('requiresFreshBaseline', false) == true);
    }
    function keepsNoAutoJudgement() {
      return !isNoAutoPlan(resource.data) || request.resource.data.get('status', '') != 'accepted'
        || (request.resource.data.d5.decision == resource.data.d5.decision
          && request.resource.data.d5.get('matrixDecision', '') == resource.data.d5.get('matrixDecision', '')
          && request.resource.data.d5.decisionRuleId == resource.data.d5.decisionRuleId);
    }
    // First recommendation stage 2 — the patient accepts EXACTLY the linked therapist's confirmation
    // (f01InitialReviews/{id}); a plan marked as needing review is never accepted without one; once
    // accepted, the confirmation, items and candidate list never change; the marker never changes.
    function claimsInitialAcceptance(next) { return next.get('initialConfirmation', null) != null; }
    function initialAcceptanceMatches(docId, next) {
      let review = get(/databases/$(database)/documents/f01InitialReviews/$(docId)).data;
      let relation = get(relationDoc(review.relationId)).data;
      return next.status == 'accepted'
        && next.initialConfirmation.therapistReviewId == docId
        && next.initialConfirmation.relationId == review.relationId
        && review.recommendationId == docId
        && review.patientId == request.auth.uid
        && review.items == next.items
        && review.basis.sourceAssessmentId == next.sourceAssessmentId
        && review.basis.selectedGoalId == next.selectedGoalId
        && review.basis.limitationIds == next.limitationIds
        && relation.therapistId == review.therapistId
        && relation.patientId == request.auth.uid
        && relation.status == 'accepted';
    }
    function requiredReviewAcceptanceOk(next) {
      return next.get('origin', null) != null || next.get('status', '') != 'accepted'
        || next.get('initialReview', {}).get('required', false) != true
        || claimsInitialAcceptance(next);
    }
    function keepsInitialAcceptance() {
      return resource.data.get('initialConfirmation', null) == null
        || (request.resource.data.get('initialConfirmation', null) == resource.data.initialConfirmation
          && request.resource.data.items == resource.data.items
          && request.resource.data.get('candidateItems', null) == resource.data.get('candidateItems', null)
          && request.resource.data.get('status', '') == resource.data.status);
    }
    function keepsInitialReviewMarker() {
      return resource.data.get('initialReview', null) == null || request.resource.data.get('initialReview', null) == resource.data.initialReview;
    }
    function isFirstRec(d) { return d.get('kind', '') == 'f01_goal' && d.get('origin', null) == null; }
    function candidateOf(d) { return d.get('candidateItems', null) != null ? d.candidateItems : d.get('items', []); }
    function idsMatch(items, ids) {
      return items is list && ids is list && items.size() == ids.size() && items.size() <= 3
        && (items.size() < 1 || items[0].exerciseId == ids[0])
        && (items.size() < 2 || items[1].exerciseId == ids[1])
        && (items.size() < 3 || items[2].exerciseId == ids[2]);
    }
    function markerMatches(d) {
      return d.get('initialReview', null) is map && d.initialReview.get('required', null) is bool
        && d.initialReview.required == ('F01-11' in d.exerciseIds && (!(d.get('limitationIds', null) is list) || 'L05' in d.limitationIds));
    }
    // A first recommendation always has at least one candidate (the G01 condition screen never saves an empty one).
    function firstRecIntegrityOk(d) { return idsMatch(candidateOf(d), d.get('exerciseIds', null)) && d.exerciseIds.size() > 0 && markerMatches(d); }
    function keepsExerciseIds() {
      return resource.data.get('exerciseIds', null) == null || request.resource.data.get('exerciseIds', null) == resource.data.exerciseIds;
    }
    match /recommendationResults/{id} {
      // Read stays open to signed-in users: these docs carry no therapistId / relationId,
      // so a linked therapist's read cannot be scoped here (see the report).
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.patientId == request.auth.uid
        && manualNoAutoAcceptanceOk(request.resource.data)
        && (!claimsReview(request.resource.data) || reviewMatches(id, request.resource.data))
        && requiredReviewAcceptanceOk(request.resource.data)
        && (!claimsInitialAcceptance(request.resource.data) || initialAcceptanceMatches(id, request.resource.data))
        && (!isFirstRec(request.resource.data) || firstRecIntegrityOk(request.resource.data));
      allow update: if request.auth != null
        && resource.data.patientId == request.auth.uid
        && request.resource.data.patientId == resource.data.patientId
        && keepsNoAutoJudgement()
        && manualNoAutoAcceptanceOk(request.resource.data)
        && (resource.data.status != 'accepted' || request.resource.data.items == resource.data.items)
        && (!claimsReview(request.resource.data) || keepsAcceptedReview(id) || reviewMatches(id, request.resource.data))
        && keepsInitialReviewMarker()
        && keepsInitialAcceptance()
        && requiredReviewAcceptanceOk(request.resource.data)
        && (!claimsInitialAcceptance(request.resource.data) || resource.data.get('initialConfirmation', null) != null || initialAcceptanceMatches(id, request.resource.data))
        && keepsExerciseIds()
        && (!isFirstRec(request.resource.data) || request.resource.data.get('exerciseIds', null) == null || firstRecIntegrityOk(request.resource.data));
      // F01 goal plans (first recommendations and next-stage proposals) are never deleted by a client:
      // cycles reference them by id and rules cannot look those references up. Other kinds keep owner delete.
      allow delete: if request.auth != null && resource.data.patientId == request.auth.uid
        && resource.data.get('kind', '') != 'f01_goal';
    }

    // ── Therapist review of a next-stage proposal ─────────────────────────
    // Only a therapist with an ACCEPTED relation to the proposal's patient may
    // write it, only for that patient's not-yet-accepted proposal (doc id =
    // proposal id). The patient can read it, never write it.
    function reviewTargetsProposal(proposalId, data) {
      let proposal = get(/databases/$(database)/documents/recommendationResults/$(proposalId)).data;
      return data.id == proposalId && data.proposalId == proposalId
        && proposal.patientId == data.patientId
        && proposal.status != 'accepted';
    }
    match /d5TherapistReviews/{proposalId} {
      allow read: if request.auth != null && (resource.data.patientId == request.auth.uid || linked(resource.data));
      allow create: if request.auth != null && linked(request.resource.data)
        && reviewTargetsProposal(proposalId, request.resource.data);
      allow update: if request.auth != null && linked(request.resource.data)
        && request.resource.data.patientId == resource.data.patientId
        && reviewTargetsProposal(proposalId, request.resource.data);
      allow delete: if false;
    }

    // ── Therapist review of a FIRST (Phase C) recommendation — stage 1 ────
    // docs/F01_INITIAL_REVIEW_PLAN.md. Only a therapist with an ACCEPTED relation to the
    // patient writes it (doc id = recommendation id), only for that patient's first
    // recommendation (kind f01_goal, no origin) that is not accepted and not marked as
    // not needing review. The patient reads it, never writes it. Nothing here lets a
    // cycle start: patient acceptance / cycle creation is stage 2 (not enforced yet).
    function initialReviewTargets(recommendationId, data) {
      let rec = get(/databases/$(database)/documents/recommendationResults/$(recommendationId)).data;
      return data.id == recommendationId && data.recommendationId == recommendationId
        && rec.patientId == data.patientId
        && rec.kind == 'f01_goal'
        && rec.get('origin', null) == null
        && rec.get('status', '') != 'accepted'
        && rec.get('initialReview', {}).get('required', true) == true;
    }
    match /f01InitialReviews/{recommendationId} {
      allow read: if request.auth != null && (resource.data.patientId == request.auth.uid || linked(resource.data));
      allow create: if request.auth != null && linked(request.resource.data)
        && initialReviewTargets(recommendationId, request.resource.data);
      allow update: if request.auth != null && linked(request.resource.data)
        && request.resource.data.patientId == resource.data.patientId
        && initialReviewTargets(recommendationId, request.resource.data);
      allow delete: if false;
    }

    // ── Functional assessment sessions (5xSTS + shoulder) — 5xSTS batch A ──
    // Design: docs/verification/fa5x-criteria-evidence/RESULT_USABILITY_DESIGN.md (第四版 A 批).
    // Owner (patientId) reads / writes; a therapist reads only through a CURRENTLY
    // accepted relation (linked() re-reads the relation document every time — the
    // therapistId / relationId stamp on the session alone grants nothing).
    // A stored measurement `result` never changes once set; `conditionReports` can
    // only grow by ONE report per write, written by the owner, earlier reports
    // unchanged; the demo flag cannot be set or changed by a client; no deletes.
    // NOT VERIFIED until run on the emulator (scripts/fa5xSessionRulesCheck.mjs) —
    // in particular the list-range comparison in sessionReportsAppendOnly().
    function sessionStampOk(data) {
      return (data.get('therapistId', '') == '' && data.get('relationId', '') == '')
        || (data.get('relationId', '') is string && data.get('relationId', '') != ''
          && exists(relationDoc(data.relationId))
          && get(relationDoc(data.relationId)).data.patientId == data.patientId
          && get(relationDoc(data.relationId)).data.therapistId == data.get('therapistId', '')
          && get(relationDoc(data.relationId)).data.status == 'accepted');
    }
    function sessionReports(data) {
      return data.get('conditionReports', []);
    }
    function validNewConditionReport(r) {
      return r is map
        && r.keys().hasOnly(['schemaVersion', 'armsUsed', 'physicalAssistance', 'chairHeightCm', 'sameChairAsBaseline', 'source', 'reportedBy', 'reportedAt'])
        && r.keys().hasAll(['schemaVersion', 'armsUsed', 'physicalAssistance', 'sameChairAsBaseline', 'source', 'reportedBy', 'reportedAt'])
        && r.schemaVersion == 'fa5x-condition-report-1'
        && r.armsUsed in ['no', 'yes', 'unknown']
        && r.physicalAssistance in ['no', 'yes', 'unknown']
        && r.sameChairAsBaseline in ['yes', 'no', 'unknown', 'not_applicable']
        && r.source in ['self_report', 'caregiver_report']
        && r.reportedBy == request.auth.uid
        && r.reportedAt is string
        && (r.get('chairHeightCm', null) == null || r.get('chairHeightCm', null) is number);
    }
    function sessionReportsAppendOnly() {
      let before = sessionReports(resource.data);
      let after = sessionReports(request.resource.data);
      return before is list && after is list
        && (after == before
          || (after.size() == before.size() + 1
            && (before.size() == 0 || after[0:before.size()] == before)
            && validNewConditionReport(after[before.size()])));
    }
    function sessionResultKept() {
      return resource.data.get('result', null) == null
        || request.resource.data.get('result', null) == resource.data.get('result', null);
    }
    match /functionalAssessmentSessions/{id} {
      allow read: if request.auth != null
        && (resource.data.patientId == request.auth.uid || linked(resource.data));
      allow create: if request.auth != null
        && request.resource.data.patientId == request.auth.uid
        && sessionStampOk(request.resource.data)
        && !('demoSynthetic' in request.resource.data)
        && sessionReports(request.resource.data) is list
        && sessionReports(request.resource.data).size() == 0;
      allow update: if request.auth != null
        && resource.data.patientId == request.auth.uid
        && request.resource.data.patientId == resource.data.patientId
        && sessionResultKept()
        && sessionReportsAppendOnly()
        && request.resource.data.get('demoSynthetic', null) == resource.data.get('demoSynthetic', null)
        && sessionStampOk(request.resource.data);
      allow delete: if false;
    }

    // B04: one daily document with append-only self-reported corrections.
    // Writes use an online transaction; no overwrite of older revisions.
    function validDailyFeedback(data, id) {
      return data.keys().hasOnly(['id', 'patientId', 'dateKey', 'schemaVersion', 'therapistId', 'relationId', 'revision', 'reports', 'createdAt', 'updatedAt'])
        && data.patientId == request.auth.uid
        && data.id == id && id == data.patientId + '_' + data.dateKey
        && data.dateKey is string && data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.schemaVersion == 'daily-training-feedback-1'
        && data.reports is list && data.revision is int
        && data.revision > 0 && data.revision <= 100 && data.reports.size() == data.revision
        && data.createdAt is timestamp && data.updatedAt == request.time
        && sessionStampOk(data);
    }
    function validDailyFeedbackReport(report) {
      return report is map
        && report.keys().hasOnly(['source', 'reportedBy', 'reportedAt', 'effort', 'discomfort', 'note', 'incompletion', 'subject'])
        && report.source == 'self_report' && report.reportedBy == request.auth.uid
        && report.reportedAt is string && report.reportedAt.size() <= 40
        && report.effort in ['not_practiced', 'easy', 'somewhat_hard', 'very_hard', 'unknown']
        && report.discomfort in ['no', 'yes', 'unknown']
        && report.note is string && report.note.size() <= 500
        && (!('incompletion' in report) || validIncompleteFeedback(report.incompletion))
        && (!('subject' in report) || validFeedbackSubject(report));
    }
    // A report saved from a tracking cycle's own entry names that cycle: it must be the reporter's own
    // cycle and plan, and an incompletion in the same report must be about the same cycle.
    function validFeedbackSubject(report) {
      let s = report.subject;
      let cycle = get(/databases/$(database)/documents/trackingCycles/$(s.cycleId)).data;
      return s is map && s.keys().hasOnly(['kind', 'cycleId', 'recommendationId']) && s.keys().hasAll(['kind', 'cycleId', 'recommendationId'])
        && s.kind == 'tracking_cycle'
        && s.cycleId is string && s.cycleId.size() > 0 && s.cycleId.size() <= 128
        && s.recommendationId is string && s.recommendationId.size() > 0 && s.recommendationId.size() <= 128
        && cycle.patientId == request.auth.uid && cycle.userId == request.auth.uid
        && cycle.recommendationId == s.recommendationId
        && (!('incompletion' in report) || report.incompletion.progress.cycleId == s.cycleId);
    }
    // Context is a patient/device-loaded snapshot, not certified measurement data.
    function validFeedbackAmount(value) {
      return value == null || (value is number && value >= 0);
    }
    function validFeedbackAttempt(a) {
      return a is map && a.keys().hasOnly(['recordId', 'totalReps', 'leftReps', 'rightReps'])
        && a.recordId is string && a.recordId.size() <= 128
        && validFeedbackAmount(a.totalReps) && validFeedbackAmount(a.leftReps) && validFeedbackAmount(a.rightReps);
    }
    function validFeedbackItem(item) {
      return item is map && item.keys().hasOnly(['exerciseId', 'name', 'targetText', 'targetBasis', 'completed', 'savedAttemptCount', 'attempts'])
        && item.exerciseId is string && item.exerciseId.size() <= 100
        && item.name is string && item.name.size() <= 60
        && item.targetText is string && item.targetText.size() <= 100
        && item.targetBasis in ['frozen', 'current_plan_unfrozen'] && item.completed is bool
        && item.savedAttemptCount is int && item.savedAttemptCount >= 0
        && item.attempts is list && item.attempts.size() <= 3 && item.attempts.size() <= item.savedAttemptCount
        && (item.attempts.size() < 1 || validFeedbackAttempt(item.attempts[0]))
        && (item.attempts.size() < 2 || validFeedbackAttempt(item.attempts[1]))
        && (item.attempts.size() < 3 || validFeedbackAttempt(item.attempts[2]));
    }
    function validIncompleteFeedback(value) {
      let p = value.progress;
      let cycle = get(/databases/$(database)/documents/trackingCycles/$(p.cycleId)).data;
      return value.keys().hasOnly(['reason', 'progress'])
        && value.reason in ['no_time', 'too_hard', 'discomfort', 'recognition_problem', 'save_problem', 'not_practiced', 'in_progress', 'other', 'unknown']
        && p.keys().hasOnly(['schemaVersion', 'source', 'cycleId', 'recommendationId', 'dateKey', 'snapshotted', 'requiredCount', 'completedCount', 'savedAttemptCount', 'omittedItemCount', 'items'])
        && p.schemaVersion == 'incomplete-training-context-1' && p.source == 'device_loaded_records'
        && p.dateKey == request.resource.data.dateKey
        && p.cycleId is string && p.recommendationId is string
        && cycle.patientId == request.auth.uid && cycle.userId == request.auth.uid
        && cycle.recommendationId == p.recommendationId
        && p.snapshotted is bool && p.requiredCount is int && p.requiredCount > 0
        && p.completedCount is int && p.completedCount >= 0 && p.completedCount < p.requiredCount
        && p.savedAttemptCount is int && p.savedAttemptCount >= 0
        && p.omittedItemCount is int && p.omittedItemCount >= 0
        && p.items is list && p.items.size() <= 6
        && p.items.size() + p.omittedItemCount == p.requiredCount
        && (p.items.size() < 1 || validFeedbackItem(p.items[0]))
        && (p.items.size() < 2 || validFeedbackItem(p.items[1]))
        && (p.items.size() < 3 || validFeedbackItem(p.items[2]))
        && (p.items.size() < 4 || validFeedbackItem(p.items[3]))
        && (p.items.size() < 5 || validFeedbackItem(p.items[4]))
        && (p.items.size() < 6 || validFeedbackItem(p.items[5]));
    }
    match /dailyTrainingFeedback/{id} {
      // A transaction must also be able to read a not-yet-existing daily document.
      allow get: if request.auth != null
        && (resource == null || resource.data.patientId == request.auth.uid || linked(resource.data));
      allow list: if request.auth != null
        && (resource.data.patientId == request.auth.uid || linked(resource.data));
      allow create: if request.auth != null && validDailyFeedback(request.resource.data, id)
        && request.resource.data.revision == 1 && request.resource.data.createdAt == request.time
        && validDailyFeedbackReport(request.resource.data.reports[0]);
      allow update: if request.auth != null && resource.data.patientId == request.auth.uid
        && validDailyFeedback(request.resource.data, id)
        && request.resource.data.patientId == resource.data.patientId
        && request.resource.data.dateKey == resource.data.dateKey
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.reports[0:resource.data.reports.size()] == resource.data.reports
        && validDailyFeedbackReport(request.resource.data.reports[resource.data.reports.size()]);
      allow delete: if false;
    }

    // B04 independent self-report ledger. It never writes analysisRecords or credit.
    function manualCount(n) { return n is int && n >= 0 && n <= 100000; }
    function manualAmount(data) {
      let a = data.actual;
      return a is map && a.keys().hasOnly(['basis', 'durationSeconds', 'totalReps', 'leftReps', 'rightReps'])
        && ((data.measurementType == 'duration' && a.basis == 'duration'
          && a.durationSeconds is int && a.durationSeconds > 0 && a.durationSeconds <= 86400
          && a.totalReps == null && a.leftReps == null && a.rightReps == null)
        || (data.measurementType == 'repetition' && a.durationSeconds == null
          && ((a.basis == 'total' && manualCount(a.totalReps) && a.totalReps > 0 && a.leftReps == null && a.rightReps == null)
          || (a.basis == 'per_side' && a.totalReps == null && manualCount(a.leftReps) && manualCount(a.rightReps) && a.leftReps + a.rightReps > 0))));
    }
    match /selfReportedTraining/{id} {
      allow get: if request.auth != null && (resource == null || resource.data.patientId == request.auth.uid || linked(resource.data));
      allow list: if request.auth != null && (resource.data.patientId == request.auth.uid || linked(resource.data));
      allow create: if request.auth != null && request.resource.data.patientId == request.auth.uid
        && request.resource.data.keys().hasOnly(['id', 'sessionId', 'schemaVersion', 'patientId', 'therapistId', 'relationId', 'exerciseId', 'exerciseName', 'measurementType', 'source', 'unrecordedPracticeAttested', 'actual', 'note', 'reportedAt', 'dateKey', 'status', 'voidedAt', 'voidReason', 'createdAt', 'updatedAt'])
        && request.resource.data.id == id && id == request.auth.uid + '_' + request.resource.data.sessionId
        && request.resource.data.sessionId is string && request.resource.data.sessionId.matches('^[A-Za-z0-9_-]{1,100}$')
        && request.resource.data.schemaVersion == 'self-reported-training-1'
        && request.resource.data.source == 'self_report' && request.resource.data.unrecordedPracticeAttested == true
        && request.resource.data.exerciseId is string && request.resource.data.exerciseId.matches('^F0[1-6]-[0-9]{2}$')
        && request.resource.data.exerciseName is string && request.resource.data.exerciseName.size() <= 100
        && request.resource.data.note is string && request.resource.data.note.size() <= 500
        && request.resource.data.reportedAt is string && request.resource.data.reportedAt.size() <= 40
        && request.resource.data.dateKey is string && request.resource.data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.status == 'recorded' && request.resource.data.voidedAt == null && request.resource.data.voidReason == ''
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
        && sessionStampOk(request.resource.data) && manualAmount(request.resource.data);
      allow update: if request.auth != null && resource.data.patientId == request.auth.uid
        && resource.data.status == 'recorded' && request.resource.data.status == 'voided'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'voidedAt', 'voidReason', 'updatedAt'])
        && request.resource.data.voidedAt == request.time && request.resource.data.updatedAt == request.time
        && request.resource.data.voidReason == '本人作廢';
      allow delete: if false;
    }

    // ── G01 坐站固定練習 (docs/F01_G01_PROGRAM_SELECTION.md 第六節) ─────────
    // Owner-only. One document per run (id fixed at start: a retry re-sends the same document).
    // The fixed target, the AI count and who/what/when are fixed at create; only the person's own
    // self-report may be added later. Never deleted by a client.
    function fixedPracticeCreateOk(id, d) {
      return d.id == id && id.matches('f01FixedPractice_' + request.auth.uid + '_[A-Za-z0-9_-]{8,64}')
        && d.kind == 'f01_fixed_practice' && d.patientId == request.auth.uid
        && d.exerciseId == 'F01-04' && d.target == {'repetitions': 5, 'sets': null}
        && (d.ai == null || d.ai is map) && (d.selfReport == null || d.selfReport is map)
        && d.instructionsReadAt is string;
    }
    match /f01FixedPracticeRecords/{id} {
      allow read: if request.auth != null && resource.data.patientId == request.auth.uid;
      allow create: if request.auth != null && fixedPracticeCreateOk(id, request.resource.data);
      allow update: if request.auth != null && resource.data.patientId == request.auth.uid
        && fixedPracticeCreateOk(id, request.resource.data)
        && request.resource.data.ai == resource.data.ai
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['selfReport', 'updatedAt']);
      allow delete: if false;
    }

    // F02–F06: observer measurements and separate CV candidates. Immutable after save.
    function domainAssessmentShape(id, d) {
      return d.keys().hasOnly(['id', 'patientId', 'domain', 'assessmentType', 'protocolVersion', 'method', 'raw', 'conditions', 'candidates', 'observerConfirmed', 'status', 'createdAt', 'therapistId', 'relationId'])
        && d.id == id && d.patientId == request.auth.uid
        && id.matches('da_' + request.auth.uid + '_[A-Za-z0-9_-]{8,100}')
        && d.protocolVersion == 'six-domain-assessment-1' && d.method == 'observer_assisted'
        && ((d.domain == 'F02' && d.assessmentType == 'sppb_balance')
          || (d.domain == 'F03' && d.assessmentType == 'tug')
          || (d.domain == 'F04' && d.assessmentType == 'gait_speed_4m')
          || (d.domain == 'F05' && d.assessmentType == 'arm_curl_30s')
          || (d.domain == 'F06' && d.assessmentType == 'chair_sit_reach'))
        && d.raw is map && d.candidates is map && d.conditions is map
        && d.conditions.keys().hasOnly(['pain', 'support', 'observer', 'setup'])
        && d.conditions.pain in ['no', 'yes', 'unknown']
        && d.conditions.support in ['none', 'aid', 'person', 'unknown']
        && d.conditions.observer in ['helper', 'therapist'] && d.conditions.setup == true
        && d.observerConfirmed is bool && d.status in ['completed', 'incomplete']
        && (d.status != 'completed' || d.observerConfirmed == true)
        && d.createdAt is string && sessionStampOk(d);
    }
    match /domainAssessmentRecords/{id} {
      allow read: if request.auth != null && (resource.data.patientId == request.auth.uid || linked(resource.data));
      allow create: if request.auth != null && domainAssessmentShape(id, request.resource.data);
      allow update: if request.auth != null && resource.data.patientId == request.auth.uid
        && domainAssessmentShape(id, request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['therapistId', 'relationId']);
      allow delete: if false;
    }

    // Other data records are scoped in the client by patientId/therapistId and
    // are loaded only after authentication. Cross-account clinical sharing for
    // these needs a relation-aware layer before they can be tightened.
    // (functionalAssessmentSessions left this list in 5xSTS batch A — it has its own rules above.)
    match /{collectionName}/{documentId} {
      allow read, create, update, delete: if request.auth != null
        && collectionName in [
          'schedules',
          'analysisRecords',
          'patientAssessments'
        ];
    }
  }
}
